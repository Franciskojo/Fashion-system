# Copy this file to .env.local and fill in real values. Never commit real secrets.

# MongoDB connection string (use a dedicated database user with a strong password)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# REQUIRED: secret used to sign login sessions (at least 32 random characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Optional: initial password for the demo accounts created when the database is first seeded
SEED_USER_PASSWORD=

# Public base URL of the app
NEXT_PUBLIC_APP_URL=http://localhost:3000
